<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CopilotSessionTray.Core\CopilotSessionTray.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Popup watermark artwork (2026-10-02/05, see IMPLEMENTATION_PLAN.md §9.5/§9.6) — 4
         color-matched variants of the bodhisattva glyph (green/orange/gold/gray, tracking the
         live tray icon's own state color), used only as a plain WPF Image.Source in
         MainWindow.xaml's popup — never as a tray-icon BackgroundSource; see
         TrayViewModel.IconBrush's doc comment for why. tray-icon-source.svg (the original art)
         is intentionally NOT included here: it's provenance only, never loaded at runtime. -->
    <Resource Include="Assets\TrayIcon.Watermark.Working.png" />
    <Resource Include="Assets\TrayIcon.Watermark.Unread.png" />
    <Resource Include="Assets\TrayIcon.Watermark.WaitingForInput.png" />
    <Resource Include="Assets\TrayIcon.Watermark.Idle.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon control (Phase 1, see IMPLEMENTATION_PLAN.md §4/§10). -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!-- MVVM helpers (ObservableObject/[ObservableProperty]/[RelayCommand]) to keep ViewModels concise. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- DI composition root (App.xaml.cs) — added 2026-09-29 per IMPLEMENTATION_PLAN.md §9.1: real
         constructor injection for TrayViewModel/MainWindow instead of field-initializer `new()`. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
