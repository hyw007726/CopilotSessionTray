<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CopilotSessionTray.Core\CopilotSessionTray.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon control (Phase 1, see IMPLEMENTATION_PLAN.md §4/§10). -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!-- MVVM helpers (ObservableObject/[ObservableProperty]/[RelayCommand]) to keep ViewModels concise. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- DI composition root (App.xaml.cs) — added 2026-09-29 per IMPLEMENTATION_PLAN.md §9.1: real
         constructor injection for TrayViewModel/MainWindow instead of field-initializer `new()`. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
