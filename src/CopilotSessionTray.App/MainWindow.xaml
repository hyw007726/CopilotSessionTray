<Window x:Class="CopilotSessionTray.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:vm="clr-namespace:CopilotSessionTray.App.ViewModels"
        mc:Ignorable="d"
        Title="Copilot Session Tray"
        Width="360" Height="420"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Visibility="Hidden"
        Deactivated="Window_Deactivated">
    <Window.DataContext>
        <vm:TrayViewModel />
    </Window.DataContext>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Non-visual: this element is what actually creates the Windows
            system tray icon (via TrayIcon.ForceCreate() in code-behind).
            Everything under it (icon glyph/color, context menu) is
            data-bound to TrayViewModel — Phase 1 fake/static data only.
        -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Grid.Row="0"
                        ToolTipText="{Binding ToolTipText}"
                        MenuActivation="RightClick"
                        TrayLeftMouseUp="TrayIcon_TrayLeftMouseUp">
            <tb:TaskbarIcon.IconSource>
                <!--
                    FontSize/TextMargin are both bound (not literal): GeneratedIconSource always
                    draws via a fixed text rectangle (derived from TextMargin) using GDI+'s
                    StringFormat.GenericTypographic, which anchors top-left rather than centering.
                    IconFontSize compensates for system DPI scaling (the control scales
                    Size/TextMargin by DPI internally but not FontSize). IconTextMargin measures
                    the actual current glyph and computes a margin that centers that specific
                    glyph — a single static margin can't center every glyph equally well, since
                    narrow glyphs like "1" occupy less visual width than "9+" at the same size.
                -->
                <tb:GeneratedIconSource Text="{Binding IconGlyph}"
                                        Foreground="White"
                                        Background="{Binding IconBrush}"
                                        FontSize="{Binding IconFontSize}"
                                        FontWeight="Bold"
                                        TextMargin="{Binding IconTextMargin}" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copilot Session Tray (demo data)" IsEnabled="False" FontWeight="Bold" />
                    <Separator />
                    <MenuItem Header="Show sessions" Click="ShowSessions_Click" />
                    <MenuItem Header="Mark all as read" Command="{Binding MarkAllReadCommand}" />
                    <MenuItem Header="Cycle demo data" Command="{Binding CycleDemoScenarioCommand}" />
                    <Separator />
                    <MenuItem Header="Mute notifications" IsCheckable="True" IsChecked="{Binding IsMuted, Mode=TwoWay}" />
                    <MenuItem Header="Run at startup" IsCheckable="True" IsChecked="{Binding RunAtStartupEnabled, Mode=TwoWay}" />
                    <MenuItem Header="Open Copilot logs folder" Command="{Binding OpenLogsFolderCommand}" />
                    <Separator />
                    <MenuItem Header="Quit" Command="{Binding QuitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <StackPanel Grid.Row="0" Margin="12,10,12,6">
            <TextBlock FontSize="14" FontWeight="Bold" Text="Copilot Session Tray" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Text="Phase 1 demo — static/fake data, not wired to real sessions yet" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Margin="8,0,8,8"
                 ItemsSource="{Binding Sessions}"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Row="0" Grid.Column="0"
                                     Width="10" Height="10"
                                     Margin="0,3,8,0"
                                     VerticalAlignment="Top"
                                     Fill="{Binding StatusBrush}" />

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Text="{Binding Detail}" />
                                <TextBlock FontSize="10" Foreground="#999999">
                                    <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ElapsedLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Ellipse Grid.Row="0" Grid.Column="2"
                                     Width="8" Height="8"
                                     Fill="#F44336"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding UnreadDotVisibility}" />

                            <!--
                                Per-session actions. Commands live on TrayViewModel (the
                                Window's DataContext), not on this row's own
                                SessionItemViewModel DataContext, so they're reached via
                                ElementName back to the root Window, passing this row's item
                                as CommandParameter.
                            -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,4,0,0">
                                <Button Padding="5,2" Margin="4,0,0,0" FontSize="10"
                                        Content="✓ Read"
                                        ToolTip="Mark this session as read"
                                        Visibility="{Binding UnreadDotVisibility}"
                                        Command="{Binding DataContext.MarkSessionReadCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}" />
                                <Button Padding="5,2" Margin="4,0,0,0" FontSize="10"
                                        Content="⤴ Resume"
                                        ToolTip="Choose how to resume this session"
                                        Click="ResumeButton_Click" />
                                <Button Padding="5,2" Margin="4,0,0,0" FontSize="10"
                                        Content="🗒 Summary"
                                        ToolTip="View this session's AI-written summary, or rename it locally"
                                        Command="{Binding DataContext.ShowSessionSummaryCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}" />
                                <Button Padding="5,2" Margin="4,0,0,0" FontSize="10"
                                        Content="✕ Remove"
                                        ToolTip="Remove this session from the list (does not touch the real Copilot session)"
                                        Command="{Binding DataContext.RemoveSessionCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="Gray"
                   Text="No sessions (demo)"
                   Visibility="{Binding EmptyStateVisibility}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="8">
            <Button Margin="0,0,8,0" Padding="8,4" Content="Cycle demo data" Command="{Binding CycleDemoScenarioCommand}" />
            <Button Padding="8,4" Content="Mark all read" Command="{Binding MarkAllReadCommand}" />
        </StackPanel>
    </Grid>
</Window>
