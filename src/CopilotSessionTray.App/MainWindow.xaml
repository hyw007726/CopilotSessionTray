<Window x:Class="CopilotSessionTray.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:vm="clr-namespace:CopilotSessionTray.App.ViewModels"
        mc:Ignorable="d"
        Title="Copilot Session Tray"
        Width="360" Height="420"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Visibility="Hidden"
        Deactivated="Window_Deactivated">
    <!--
        DataContext is no longer constructed here: TrayViewModel now takes its Core service
        dependencies via constructor injection (see App.xaml.cs's DI composition root), so XAML
        can no longer new() it up directly (no parameterless constructor) — code-behind sets
        DataContext instead, from the instance the container resolved and passed in.
    -->


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Non-visual: this element is what actually creates the Windows
            system tray icon (via TrayIcon.ForceCreate() in code-behind).
            Everything under it (icon glyph/color, context menu) is
            data-bound to TrayViewModel — Phase 1 fake/static data only.
        -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Grid.Row="0"
                        ToolTipText="{Binding ToolTipText}"
                        MenuActivation="RightClick"
                        TrayLeftMouseUp="TrayIcon_TrayLeftMouseUp"
                        TrayLeftMouseDoubleClick="TrayIcon_TrayLeftMouseDoubleClick"
                        TrayBalloonTipClicked="TrayIcon_TrayBalloonTipClicked">
            <!--
                No IconSource binding here (2026-10-05, IMPLEMENTATION_PLAN.md §9.6 follow-up) —
                deliberately removed, not merely left unused. A GeneratedIconSource bound via
                IconSource makes TaskbarIcon subscribe to its own DependencyPropertyChanged event
                and call the library's un-awaited, fire-and-forget ToIconAsync() on *every* change
                — confirmed (via a real crash, reproduced on demand, not just reasoned about) that
                two such changes close enough together race on the same non-thread-safe GDI+
                Bitmap/Graphics objects, regardless of how the properties change or how fast.
                Rapid, completely ordinary clicks on "Cycle demo data" were enough to reproduce it
                — not just the since-removed continuous flash timer this was first found with
                (IMPLEMENTATION_PLAN.md §9.5/§9.6). TrayIcon.Icon is instead set directly, once per
                real change, synchronously on the UI thread, from MainWindow.xaml.cs's
                UpdateTrayIcon() — see its own doc comment for why that's actually race-free.
            -->
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding TrayMenuHeaderText}" IsEnabled="False" FontWeight="Bold" />
                    <Separator />
                    <MenuItem Header="Show sessions" Click="ShowSessions_Click" />
                    <MenuItem Header="Start new task…" Command="{Binding StartYoloTaskCommand}" />
                    <MenuItem Header="Session history…" Command="{Binding ShowSessionHistoryCommand}" />
                    <MenuItem Header="Mark all as read" Command="{Binding MarkAllReadCommand}" />
                    <MenuItem Header="Cycle demo data" Command="{Binding CycleDemoScenarioCommand}" />
                    <Separator />
                    <MenuItem Header="Mute notifications" IsCheckable="True" IsChecked="{Binding IsMuted, Mode=TwoWay}" />
                    <MenuItem Header="Run at startup" IsCheckable="True" IsChecked="{Binding RunAtStartupEnabled, Mode=TwoWay}" />
                    <MenuItem Header="Open Copilot logs folder" Command="{Binding OpenLogsFolderCommand}" />
                    <Separator />
                    <MenuItem Header="Quit" Command="{Binding QuitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <StackPanel Grid.Row="0" Margin="12,10,12,6">
            <TextBlock FontSize="14" FontWeight="Bold" Text="Copilot Session Tray" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Text="{Binding HeaderSubtitleText}" />
        </StackPanel>

        <!--
            Watermark (2026-10-02, see IMPLEMENTATION_PLAN.md §9.4/§9.5) — the same bodhisattva
            artwork as the tray icon, faint and color-matched to its current state (green/orange/
            gray — see TrayViewModel.WatermarkImageSource), purely decorative/branding behind the
            session list and empty-state text. Declared before (so behind, in z-order) the
            ListBox/empty-state TextBlock below, both of which keep a transparent background
            specifically so this shows through. IsHitTestVisible/Focusable=False so it can never
            intercept clicks meant for the list/buttons on top of it. Plain Image.Source binding
            — deliberately not going anywhere near H.NotifyIcon/GeneratedIconSource, so none of
            the concurrency risk documented on TrayViewModel.IconBrush applies here.
        -->
        <Image Grid.Row="1"
               Source="{Binding WatermarkImageSource}"
               Width="220" Height="220"
               Opacity="0.08"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="0,0,0,40"
               IsHitTestVisible="False"
               Focusable="False" />

        <ListBox Grid.Row="1"
                 Margin="8,0,8,8"
                 ItemsSource="{Binding Sessions}"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Row="0" Grid.Column="0"
                                     Width="10" Height="10"
                                     Margin="0,3,8,0"
                                     VerticalAlignment="Top"
                                     Fill="{Binding StatusBrush}"
                                     Visibility="{Binding StatusDotVisibility}" />

                            <!--
                                Golden bodhisattva glyph shown instead of the plain dot for
                                Idle rows (2026-10-05, user request) — reuses the existing
                                gold watermark asset at icon size; see
                                SessionItemViewModel.StatusIconSource's own doc comment.
                            -->
                            <Image Grid.Row="0" Grid.Column="0"
                                   Width="15" Height="15"
                                   Margin="-2,1,8,0"
                                   VerticalAlignment="Top"
                                   Stretch="Uniform"
                                   Source="{Binding StatusIconSource}"
                                   Visibility="{Binding StatusIconVisibility}" />

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Text="{Binding Detail}" />
                                <!-- Foreground bound to StatusBrush (2026-10-05, §9.6) so the
                                     status text itself is color-coded the same as its dot/the
                                     tray icon (e.g. green for "Working"), not just the dot. -->
                                <TextBlock FontSize="10" Foreground="{Binding StatusBrush}">
                                    <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ElapsedLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Ellipse Grid.Row="0" Grid.Column="2"
                                     Width="8" Height="8"
                                     Fill="#F44336"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding UnreadDotVisibility}" />

                            <!--
                                Per-session actions. Commands live on TrayViewModel (the
                                Window's DataContext), not on this row's own
                                SessionItemViewModel DataContext, so they're reached via
                                ElementName back to the root Window, passing this row's item
                                as CommandParameter.
                            -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,4,0,0">
                                <Button Padding="5,2" Margin="4,0,0,0" FontSize="10"
                                        Content="✓ Read"
                                        ToolTip="Mark this session as read"
                                        Visibility="{Binding UnreadDotVisibility}"
                                        Command="{Binding DataContext.MarkSessionReadCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}" />
                                <Button Padding="5,2" Margin="4,0,0,0" FontSize="10"
                                        Content="⤴ Resume"
                                        ToolTip="Choose how to resume this session"
                                        Click="ResumeButton_Click" />
                                <Button Padding="5,2" Margin="4,0,0,0" FontSize="10"
                                        Content="🗒 Summary"
                                        ToolTip="View this session's AI-written summary, or rename it locally"
                                        Command="{Binding DataContext.ShowSessionSummaryCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}" />
                                <Button Padding="5,2" Margin="4,0,0,0" FontSize="10"
                                        Content="✕ Remove"
                                        ToolTip="Remove this session from the list (does not touch the real Copilot session)"
                                        Command="{Binding DataContext.RemoveSessionCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   MaxWidth="280"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="Gray"
                   Text="{Binding EmptyStateText}"
                   Visibility="{Binding EmptyStateVisibility}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="8">
            <Button Margin="0,0,8,0" Padding="8,4" Content="Cycle demo data" Command="{Binding CycleDemoScenarioCommand}" />
            <Button Padding="8,4" Content="Mark all read" Command="{Binding MarkAllReadCommand}" />
        </StackPanel>
    </Grid>
</Window>
