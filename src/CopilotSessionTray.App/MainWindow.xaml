<Window x:Class="CopilotSessionTray.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:vm="clr-namespace:CopilotSessionTray.App.ViewModels"
        mc:Ignorable="d"
        Title="Copilot Session Tray"
        Width="360" Height="420"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Visibility="Hidden"
        Deactivated="Window_Deactivated">
    <Window.DataContext>
        <vm:TrayViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Non-visual: this element is what actually creates the Windows
            system tray icon (via TrayIcon.ForceCreate() in code-behind).
            Everything under it (icon glyph/color, context menu) is
            data-bound to TrayViewModel — Phase 1 fake/static data only.
        -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Grid.Row="0"
                        ToolTipText="{Binding ToolTipText}"
                        MenuActivation="RightClick"
                        TrayLeftMouseUp="TrayIcon_TrayLeftMouseUp">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="{Binding IconGlyph}"
                                        Foreground="White"
                                        Background="{Binding IconBrush}"
                                        FontSize="52"
                                        FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copilot Session Tray (demo data)" IsEnabled="False" FontWeight="Bold" />
                    <Separator />
                    <MenuItem Header="Show sessions" Click="ShowSessions_Click" />
                    <MenuItem Header="Mark all as read" Command="{Binding MarkAllReadCommand}" />
                    <MenuItem Header="Cycle demo data" Command="{Binding CycleDemoScenarioCommand}" />
                    <Separator />
                    <MenuItem Header="Mute notifications" IsCheckable="True" IsChecked="{Binding IsMuted, Mode=TwoWay}" />
                    <MenuItem Header="Run at startup" IsCheckable="True" IsChecked="{Binding RunAtStartupEnabled, Mode=TwoWay}" />
                    <MenuItem Header="Open Copilot logs folder" Command="{Binding OpenLogsFolderCommand}" />
                    <Separator />
                    <MenuItem Header="Quit" Command="{Binding QuitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <StackPanel Grid.Row="0" Margin="12,10,12,6">
            <TextBlock FontSize="14" FontWeight="Bold" Text="Copilot Session Tray" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Text="Phase 1 demo — static/fake data, not wired to real sessions yet" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Margin="8,0,8,8"
                 ItemsSource="{Binding Sessions}"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0"
                                     Width="10" Height="10"
                                     Margin="0,3,8,0"
                                     VerticalAlignment="Top"
                                     Fill="{Binding StatusBrush}" />

                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap" Text="{Binding Detail}" />
                                <TextBlock FontSize="10" Foreground="#999999">
                                    <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ElapsedLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Ellipse Grid.Column="2"
                                     Width="8" Height="8"
                                     Fill="#F44336"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding UnreadDotVisibility}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="Gray"
                   Text="No sessions (demo)"
                   Visibility="{Binding EmptyStateVisibility}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="8">
            <Button Margin="0,0,8,0" Padding="8,4" Content="Cycle demo data" Command="{Binding CycleDemoScenarioCommand}" />
            <Button Padding="8,4" Content="Mark all read" Command="{Binding MarkAllReadCommand}" />
        </StackPanel>
    </Grid>
</Window>
