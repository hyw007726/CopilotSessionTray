<Window x:Class="CopilotSessionTray.App.SessionSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Session summary"
        Width="580" Height="580"
        MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="Renaming only changes this app's own local label — it never touches the real Copilot CLI session." />

        <StackPanel Grid.Row="1" Margin="0,10,0,4">
            <TextBlock FontSize="11" FontWeight="SemiBold" Text="Session name" />
            <TextBox Margin="0,2,0,0"
                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,10,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="11" FontWeight="SemiBold" Text="Summary" />
            <TextBlock x:Name="SourceText"
                       Grid.Column="1"
                       Margin="12,0,0,0"
                       HorizontalAlignment="Right"
                       FontSize="11" Foreground="Gray"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Border Grid.Row="3"
                BorderBrush="#DDDDDD" BorderThickness="1"
                Background="#FAFAFA">
            <RichTextBox x:Name="SummaryBox"
                         AutomationProperties.Name="Summary text"
                         IsReadOnly="True"
                         IsDocumentEnabled="False"
                         IsReadOnlyCaretVisible="False"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="8,6" />
        </Border>

        <Expander Grid.Row="4"
                  Margin="0,10,0,0"
                  FontSize="11.5"
                  Header="Text sent to Copilot when starting a new session from this summary">
            <Grid Margin="0,6,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="SeedBox"
                         AutomationProperties.Name="Text sent to Copilot"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="150"
                         FontFamily="Consolas" FontSize="11"
                         Background="#FAFAFA"
                         Padding="6" />
                <Button x:Name="CopyButton"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="0,6,0,0"
                        Padding="10,3"
                        Content="Copy"
                        Click="CopySeed_Click" />
            </Grid>
        </Expander>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Padding="10,4" Content="Close" Click="Close_Click" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
