<Window x:Class="CopilotSessionTray.App.NewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Start a new Copilot task"
        Width="400" Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="WarningText"
                   Grid.Row="0"
                   FontSize="11" TextWrapping="Wrap"
                   Text="Copilot will ask for confirmation before running tools, editing files, or accessing URLs — the normal, safer default." />

        <TextBlock Grid.Row="1" Margin="0,10,0,4" FontSize="11" FontWeight="SemiBold" Text="Prompt" />
        <TextBox x:Name="PromptBox"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="Inputs_Changed" />

        <TextBlock Grid.Row="3" Margin="0,10,0,4" FontSize="11" FontWeight="SemiBold" Text="Workspace" />
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WorkspaceBox" Grid.Column="0" IsReadOnly="True" TextChanged="Inputs_Changed" />
            <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,2" Content="Browse…" Click="Browse_Click" />
        </Grid>

        <CheckBox x:Name="AllowAllPermissionsCheckBox"
                  Grid.Row="5"
                  Margin="0,10,0,0"
                  Content="Enable all permissions — runs unattended, no confirmation prompts at all"
                  Checked="AllowAllPermissionsCheckBox_Changed"
                  Unchecked="AllowAllPermissionsCheckBox_Changed" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Padding="10,4" Margin="0,0,8,0" Content="Cancel" Click="Cancel_Click" IsCancel="True" />
            <Button x:Name="StartButton" Padding="10,4" Content="Start" Click="Start_Click" IsDefault="True" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
