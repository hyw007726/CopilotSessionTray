<Window x:Class="CopilotSessionTray.App.SessionLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session label"
        Width="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SessionNameText"
                   Grid.Row="0"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Row="1"
                   Margin="0,2,0,0"
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="The label shows under the session's name in the popup. Leave it empty to remove it." />

        <TextBox x:Name="LabelBox"
                 Grid.Row="2"
                 Margin="0,10,0,0"
                 AutomationProperties.Name="Label" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button MinWidth="64" Padding="10,4" Margin="0,0,8,0" Content="Cancel" Click="Cancel_Click" IsCancel="True" />
            <Button MinWidth="64" Padding="10,4" Content="Save" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
