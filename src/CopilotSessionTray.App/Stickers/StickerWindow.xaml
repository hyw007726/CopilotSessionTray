<Window x:Class="CopilotSessionTray.App.Stickers.StickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DisplayName}"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        MinWidth="170"
        MinHeight="88"
        UseLayoutRounding="True"
        TextElement.FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="WorkingBrush" Color="#B6E3B0" />
        <SolidColorBrush x:Key="IdleBrush" Color="#FFF6B0" />
        <SolidColorBrush x:Key="InkBrush" Color="#1F2933" />
        <SolidColorBrush x:Key="SubInkBrush" Color="#485664" />
        <SolidColorBrush x:Key="EdgeBrush" Color="#4D000000" />

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,-2,-4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource SubInkBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hover" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#2E000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#47000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="GripTemplate" TargetType="Thumb">
            <Grid Background="Transparent">
                <Path Data="M 14,4 L 4,14 M 14,8 L 8,14 M 14,12 L 12,14"
                      Stroke="{StaticResource SubInkBrush}"
                      StrokeThickness="1"
                      Opacity="0.55"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" />
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="EdgeTemplate" TargetType="Thumb">
            <Border Background="Transparent" />
        </ControlTemplate>
    </Window.Resources>

    <Border x:Name="Card"
            CornerRadius="7"
            BorderThickness="1"
            BorderBrush="{StaticResource EdgeBrush}"
            Padding="10,7,8,6"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource IdleBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                        <Setter Property="Background" Value="{StaticResource WorkingBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           LineStackingStrategy="BlockLineHeight"
                           Foreground="{StaticResource InkBrush}"
                           Text="{Binding DisplayName}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
                <Button x:Name="HideButton"
                        Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="✕"
                        AutomationProperties.Name="Hide sticker"
                        ToolTip="Hide until this session changes state"
                        Click="HideButton_Click" />
            </Grid>

            <TextBlock x:Name="GistText"
                       Grid.Row="1"
                       Margin="0,4,0,4"
                       FontSize="11.5"
                       Foreground="{StaticResource InkBrush}"
                       Text="{Binding Gist}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       ToolTip="{Binding Gist}" />

            <TextBlock x:Name="TimeText"
                       Grid.Row="2"
                       FontSize="10"
                       Foreground="{StaticResource SubInkBrush}"
                       Text="{Binding TimeLine}"
                       TextTrimming="CharacterEllipsis" />

            <Thumb x:Name="RightEdge"
                   Grid.RowSpan="3"
                   HorizontalAlignment="Right"
                   Width="7"
                   Margin="0,24,-8,18"
                   Cursor="SizeWE"
                   Template="{StaticResource EdgeTemplate}"
                   DragDelta="RightEdge_DragDelta"
                   DragCompleted="Resize_DragCompleted" />
            <Thumb x:Name="BottomEdge"
                   Grid.RowSpan="3"
                   VerticalAlignment="Bottom"
                   Height="7"
                   Margin="0,0,18,-7"
                   Cursor="SizeNS"
                   Template="{StaticResource EdgeTemplate}"
                   DragDelta="BottomEdge_DragDelta"
                   DragCompleted="Resize_DragCompleted" />
            <Thumb x:Name="Grip"
                   Grid.RowSpan="3"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Width="16"
                   Height="16"
                   Margin="0,0,-6,-4"
                   Cursor="SizeNWSE"
                   Template="{StaticResource GripTemplate}"
                   DragDelta="Grip_DragDelta"
                   DragCompleted="Resize_DragCompleted" />
        </Grid>
    </Border>
</Window>
